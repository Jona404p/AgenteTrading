# ── Entorno ───────────────────────────────
BINANCE_ENV=testnet              # testnet | live
CONFIRM_LIVE_TRADING=NO          # debe ser YES para operar en live
BINANCE_MARKET_TYPE=spot         # spot | future

# ── Credenciales (separadas por entorno) ──
# Testnet Spot: https://testnet.binance.vision (cuenta y keys independientes de la real)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# ── Datos ─────────────────────────────────
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
HISTORY_DAYS=365
HISTORICAL_FROM_LIVE=true        # descargar histórico desde endpoints públicos reales
WS_DEPTH_LEVELS=20               # 5 | 10 | 20
LOG_LEVEL=INFO

# ── LLM (Fase 2) ──────────────────────────
LLM_PROVIDER=anthropic           # anthropic | openai | ollama
LLM_MODEL=claude-sonnet-5-5      # ej.: gpt-4o-mini (openai) | llama3.1 (ollama)
LLM_TEMPERATURE=0                # déjalo vacío si el modelo no admite temperatura
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Sentimiento ───────────────────────────
SENTIMENT_LOOKBACK_HOURS=12
SENTIMENT_MAX_HEADLINES=30
SENTIMENT_BATCH_SIZE=15
SENTIMENT_HALF_LIFE_HOURS=6
SENTIMENT_EVIDENCE_REF=3.0       # peso acumulado necesario para confianza = 1
SENTIMENT_REFRESH_MINUTES=15
SENTIMENT_CACHE_TTL_HOURS=24
NEWS_HTTP_TIMEOUT=10
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://www.federalreserve.gov/feeds/press_all.xml

# ── RL (Fase 3) ───────────────────────────
RL_ALGO=ppo                      # ppo | a2c | sac
RL_TOTAL_TIMESTEPS=300000
RL_N_ENVS=4
RL_SEED=42
RL_WINDOW=8                      # velas que ve el agente
RL_EPISODE_LEN=720               # velas por episodio de entrenamiento (0 = serie completa)
RL_INITIAL_CASH=10000
RL_MAX_LEVERAGE=1.0
RL_ALLOW_SHORT=false             # solo aplica con BINANCE_MARKET_TYPE=future
RL_TAKER_FEE_BPS=10              # Spot 10 bps; Futures USDT-M 5 bps (default automático)
RL_MAKER_FEE_BPS=10
RL_FEE_DISCOUNT=0                # 0.25 = pago de comisiones con BNB
RL_BASE_SLIPPAGE_BPS=1
RL_IMPACT_COEF_BPS=10
RL_MIN_REBALANCE=0.05            # banda muerta de exposición
RL_REWARD_SCALE=100
RL_DRAWDOWN_PENALTY=0.5
RL_TURNOVER_PENALTY=0.0
RL_RUIN_EQUITY_FRAC=0.5
RL_TRAIN_FRAC=0.70
RL_VAL_FRAC=0.15

# ── Riesgo (Fase 4) ───────────────────────
# Topes no ampliables por .env: 3% diario, 1x exposición total, 25% del equity por orden, 2 ATR de stop.
RISK_KELLY_FRACTION=0.25         # 0.25 = cuarto de Kelly
RISK_KELLY_MIN_TRADES=30         # operaciones cerradas para fiarse del Kelly empírico
RISK_KELLY_WINDOW_TRADES=100
RISK_KELLY_BOOTSTRAP_CAP=0.25    # tope de exposición mientras hay pocas operaciones
RISK_KELLY_FLOOR=0.10            # exposición mínima aun sin ventaja (para poder recuperarse)
RISK_MAX_POSITION_FRAC=1.0       # |exposición| máx. por símbolo (fracción del equity)
RISK_MAX_TOTAL_EXPOSURE=1.0
RISK_MAX_LEVERAGE=1.0
RISK_ALLOW_SHORT=false           # solo aplica con BINANCE_MARKET_TYPE=future
RISK_VAR_CONFIDENCE=0.95
# RISK_VAR_HORIZON_BARS=24      # por defecto = 1 día según TIMEFRAME
RISK_VAR_LIMIT_PCT=0.03          # VaR máximo (fracción del equity) al horizonte
RISK_VAR_WINDOW=720
RISK_VAR_MIN_OBS=100
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.15
RISK_FLATTEN_ON_DAILY_HALT=false
RISK_FLATTEN_ON_DRAWDOWN_HALT=true
RISK_DRAWDOWN_COOLDOWN_HOURS=0   # 0 = solo reinicio manual
RISK_MAX_CONSECUTIVE_LOSSES=5
RISK_LOSS_COOLDOWN_MINUTES=120
RISK_SL_ATR_MULT=2.0
RISK_TP_ATR_MULT=4.0             # 0 = sin take-profit
RISK_TRAIL_ATR_MULT=2.5          # 0 = sin trailing
RISK_REENTRY_COOLDOWN_MINUTES=60
RISK_MAX_SPREAD_BPS=15
RISK_MAX_PARTICIPATION=0.02      # fracción máx. del volumen de la vela por orden
RISK_MIN_NOTIONAL=10             # USDT
RISK_SENTIMENT_MIN_CONFIDENCE=0.3
RISK_SENTIMENT_BEARISH=35
RISK_SENTIMENT_BULLISH=65
RISK_SENTIMENT_DERISK_FACTOR=0.5

# ── Panel web (Fase 5, opcional) ───────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_TOKEN=

# ── Ejecución paper ────────────────────────
LIVE_STATE_DIR=data/live
LIVE_MODELS_ROOT=data/models
LIVE_WARMUP_CANDLES=400
PAPER_INITIAL_CASH=10000
LIVE_SHUTDOWN_TIMEOUT_SECONDS=30
LIVE_FLATTEN_ON_EXIT=false
EXECUTION_MIN_REBALANCE=0.05
DRIFT_ENABLED=true
DRIFT_PSI_THRESHOLD=0.25
DRIFT_CRITICAL_PSI_THRESHOLD=0.5
DRIFT_CRITICAL_FEATURE_FRACTION=0.5
DRIFT_MAX_DRAWDOWN=0.20
